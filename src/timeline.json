  "phrases": [
    {
      "id": "p01",
      "text": "قداش من Client خسرتو",
      "start": 0.3,
      "end": 2.0
    },
    {
      "id": "p02",
      "text": "من غير ما تعرف علاش وكيفاش؟",
      "start": 2.18,
      "end": 4.18
    },
    {
      "id": "p03",
      "text": "ممكن الـ Service ولا الـ Produit اللي تقدّم فيه",
      "start": 4.68,
      "end": 7.28
    },
    {
      "id": "p04",
      "text": "برشا عباد يلوجو عليه،",
      "start": 7.46,
      "end": 8.96
    },
    {
      "id": "p05",
      "text": "أما ما فماش Process واضح",
      "start": 9.14,
      "end": 10.84
    },
    {
      "id": "p06",
      "text": "ولا شنوا لازمهم يعملو باش يوصلولك.",
      "start": 11.02,
      "end": 13.32
    },
    {
      "id": "p07",
      "text": "ممكن حتى تعمل Ad",
      "start": 13.82,
      "end": 15.02
    },
    {
      "id": "p08",
      "text": "وتصرف عليها برشا فلوس",
      "start": 15.2,
      "end": 16.8
    },
    {
      "id": "p09",
      "text": "والـ Client يضيع في الـ Inbox",
      "start": 16.98,
      "end": 18.78
    },
    {
      "id": "p10",
      "text": "ولا يختار حد آخر،",
      "start": 18.96,
      "end": 20.16
    },
    {
      "id": "p11",
      "text": "juste خاطر مش عارف الخطوة اللي بعدها.",
      "start": 20.34,
      "end": 22.74
    },
    {
      "id": "p12",
      "text": "قبل ما تصرف برشا فلوس على الـ Ads،",
      "start": 23.49,
      "end": 25.69
    },
    {
      "id": "p13",
      "text": "وفّرلو تجربة واضحة بعد الـ Click.",
      "start": 25.87,
      "end": 28.17
    },
    {
      "id": "p14",
      "text": "وخدمتنا إنّا نبنيو تجربة",
      "start": 28.77,
      "end": 30.47
    },
    {
      "id": "p15",
      "text": "تتماشى مع الـ Produit / Service اللي تقدّم فيه،",
      "start": 30.65,
      "end": 33.25
    },
    {
      "id": "p16",
      "text": "وتخلّي الـ Client فاهم شنوا توفّر",
      "start": 33.43,
      "end": 35.43
    },
    {
      "id": "p17",
      "text": "وشنوا لازم يعمل.",
      "start": 35.61,
      "end": 36.81
    },
    {
      "id": "p18",
      "text": "تواصل معانا،",
      "start": 37.31,
      "end": 38.31
    },
    {
      "id": "p19",
      "text": "وإحنا نفسرولك أكثر.",
      "start": 38.49,
      "end": 39.99
    }
  ]
}
